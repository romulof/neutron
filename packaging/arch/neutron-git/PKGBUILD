# Maintainer: Rômulo Ruas <romulo.fernandes@gmail.com>
pkgname=neutron-git
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="Steam Proton compatibility tool and environment manager UI"
arch=('x86_64' 'aarch64')
url="https://github.com/romulof/neutron"
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
)
makedepends=('cargo' 'git')
optdepends=(
  'gamemode: Feral GameMode performance governor support'
  'gamescope: SteamOS GameScope micro-compositor support'
  'mangohud: MangoHud performance overlay support'
  'steam: Steam client and Proton compatibility tool integration'
)
provides=('neutron')
conflicts=('neutron')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')
options=('!debug')

pkgver() {
  cd "$pkgname"
  if desc=$(git describe --long --tags --abbrev=7 2>/dev/null); then
    printf '%s\n' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --all-features
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
