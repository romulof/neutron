#!/usr/bin/env bash
set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
APPDIR="${APPDIR:-$HERE}"

# Preserve host/Steam environment variables before AppImage runtime hooks modify them,
# so Neutron can restore them before exec'ing Proton, Steam Linux Runtime, or games.
export NEUTRON_APPIMAGE_ENV=1

_neutron_vars=(
  PATH
  LD_LIBRARY_PATH
  XDG_DATA_DIRS
  GDK_BACKEND
  GDK_PIXBUF_MODULE_FILE
  GDK_PIXBUF_MODULEDIR
  GTK_PATH
  GTK_EXE_PREFIX
  GTK_DATA_PREFIX
  GTK_IM_MODULE_FILE
  GTK_THEME
  GSETTINGS_SCHEMA_DIR
  GI_TYPELIB_PATH
  GIO_EXTRA_MODULES
)

for _var in "${_neutron_vars[@]}"; do
  if [[ -n "${!_var+x}" ]]; then
    export "NEUTRON_ORIG_${_var}=${!_var}"
  else
    export "NEUTRON_UNSET_${_var}=1"
  fi
done
unset _var _neutron_vars

# Run any plugin hooks generated by linuxdeploy-plugin-gtk
if [[ -d "$APPDIR/apprun-hooks" ]]; then
  for _hook in "$APPDIR/apprun-hooks"/*.sh; do
    if [[ -r "$_hook" ]]; then
      # shellcheck disable=SC1090
      source "$_hook"
    fi
  done
  unset _hook
fi

export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export PATH="$APPDIR/usr/bin:$PATH"

exec "$APPDIR/usr/bin/neutron" "$@"
